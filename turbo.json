{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["APP_VARIANT", "VOXTYPE_BUILD_COMMIT"],
  "globalPassThroughEnv": [
    "DBUS_SESSION_BUS_ADDRESS",
    "DISPLAY",
    "GDK_BACKEND",
    "PIPEWIRE_REMOTE",
    "PULSE_SERVER",
    "WAYLAND_DISPLAY",
    "XDG_RUNTIME_DIR",
    "XDG_SESSION_TYPE"
  ],
  "tasks": {
    "android": {
      "cache": false,
      "persistent": true,
      "env": ["EXPO_PUBLIC_API_URL"],
      "passThroughEnv": ["ANDROID_HOME", "ANDROID_SDK_ROOT", "JAVA_HOME"]
    },
    "db:migrate:local": {
      "cache": false
    },
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["TAURI_*", "VITE_*"],
      "outputs": ["dist/**"]
    },
    "build:desktop": {
      "dependsOn": ["build", "check-types"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["TAURI_*", "VITE_*", "VOXTYPE_API_URL", "VOXTYPE_ENV"],
      "outputs": ["src-tauri/target/release/bundle/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["TAURI_*", "VITE_*", "VOXTYPE_API_URL", "VOXTYPE_ENV"]
    }
  }
}
