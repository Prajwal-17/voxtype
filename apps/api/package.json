{
  "name": "@voxtype/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy:production": "node scripts/validate-production-config.mjs && wrangler deploy --env production",
    "types": "wrangler types",
    "check-types": "wrangler types --check && tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/validate-production-config.mjs && wrangler d1 migrations apply DB --remote --env production"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.6",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "zod": "^4.6.5",
    "@voxtype/shared": "workspace:*"
  },
  "devDependencies": {
    "@voxtype/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "wrangler": "^4.142.0"
  }
}
