{
  "applicationId": "com.prajwal.flow",
  "version": "0.1.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "nativeAllowList": [
    "app.exit",
    "os.execCommand",
    "os.getEnv",
    "os.setTray",
    "os.showNotification",
    "os.spawnProcess",
    "os.updateSpawnedProcess",
    "window.*"
  ],
  "modes": {
    "window": {
      "title": "Flow",
      "icon": "dist/flow.png",
      "width": 640,
      "height": 650,
      "minWidth": 360,
      "minHeight": 80,
      "enableInspector": false,
      "hidden": true,
      "skipTaskbar": true,
      "exitProcessOnClose": false,
      "useSavedState": false
    }
  },
  "cli": {
    "binaryName": "flow",
    "resourcesPath": "/dist/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}
