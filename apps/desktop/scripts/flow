#!/usr/bin/env bash
set -euo pipefail

command=${1:-toggle}
case "${command}" in
  toggle|cancel|settings) ;;
  *) printf 'Usage: flow {toggle|cancel|settings}\n' >&2; exit 2 ;;
esac

runtime=${XDG_RUNTIME_DIR:-}
fifo="${runtime}/flow/commands"
if [[ -n "${runtime}" && -p "${fifo}" ]]; then
  # The app owns this private FIFO. timeout prevents a stale FIFO from
  # blocking a GNOME shortcut if Flow was killed unexpectedly.
  if timeout 1 bash -c 'printf "%s\n" "$1" > "$2"' _ "${command}" "${fifo}"; then
    exit 0
  fi
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
binary="${FLOW_BINARY:-${script_dir}/flow-linux_x64}"
if [[ ! -x "${binary}" ]]; then
  printf 'Flow is not installed beside this launcher.\n' >&2
  exit 1
fi
exec "${binary}" "--flow-command=${command}"
