{
  "name": "@voxtype/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VOXTYPE_ENV=development VITE_VOXTYPE_ENV=development tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:desktop": "VOXTYPE_ENV=production VITE_VOXTYPE_ENV=production tauri build --bundles deb",
    "build:desktop:dev": "VOXTYPE_ENV=development VITE_VOXTYPE_ENV=development tauri build --bundles deb --config src-tauri/tauri.dev.conf.json",
    "check-types": "tsc --noEmit",
    "typecheck": "pnpm check-types",
    "lint": "eslint . --max-warnings 0 && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "pnpm test:web && pnpm test:rust",
    "test:web": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@voxtype/design-system": "workspace:*",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@voxtype/eslint-config": "workspace:*",
    "@voxtype/typescript-config": "workspace:*",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.11.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
